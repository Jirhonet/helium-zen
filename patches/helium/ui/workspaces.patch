+
+void WorkspaceController::OnBrowserCreated(BrowserWindowInterface* browser) {
+  if (browser != browser_) {
+    return;
+  }
+
+  browser_collection_observation_.Reset();
+  UpdateSessionActiveWorkspace();
+  for (const auto& [id, stash] : stashes_) {
+    UpdateSessionForWorkspace(id);
+  }
+}
+
+void WorkspaceController::LoadWorkspacesFromPrefs() {
+  workspaces_.clear();
+  for (const base::Value& value :
+       pref_service_->GetList(prefs::kHeliumWorkspaces)) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    const std::string* const id = value.GetDict().FindString(kIdKey);
+    const std::string* const name = value.GetDict().FindString(kNameKey);
+    if (!id || id->empty() || GetWorkspaceIndex(*id)) {
+      continue;
+    }
+    Workspace workspace;
+    workspace.id = *id;
+    workspace.name = name ? base::UTF8ToUTF16(*name) : std::u16string();
+    if (workspace.name.empty()) {
+      workspace.name = GetDefaultNameForNewWorkspace();
+    }
+    workspaces_.push_back(std::move(workspace));
+  }
+
+  if (workspaces_.empty()) {
+    Workspace workspace;
+    workspace.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    workspace.name = l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_DEFAULT_NAME);
+    workspaces_.push_back(std::move(workspace));
+    SaveWorkspacesToPrefs();
+  }
+}
+
+void WorkspaceController::SaveWorkspacesToPrefs() {
+  base::AutoReset<bool> updating(&updating_prefs_, true);
+  pref_service_->SetList(prefs::kHeliumWorkspaces,
+                         SerializeWorkspaces(workspaces_));
+}
+
+void WorkspaceController::OnWorkspacesPrefChanged() {
+  if (updating_prefs_) {
+    return;
+  }
+
+  const std::optional<size_t> old_active_index =
+      GetWorkspaceIndex(active_workspace_id_);
+  LoadWorkspacesFromPrefs();
+
+  // Close the tabs of deleted workspaces.
+  std::vector<std::string> deleted_ids;
+  for (const auto& [id, stash] : stashes_) {
+    if (!GetWorkspaceIndex(id)) {
+      deleted_ids.push_back(id);
+    }
+  }
+
+  // Leave the active workspace if it was deleted. Its tabs end up in a stash
+  // that is closed below.
+  if (!GetWorkspaceIndex(active_workspace_id_)) {
+    deleted_ids.push_back(active_workspace_id_);
+    const size_t index =
+        std::min(old_active_index.value_or(0), workspaces_.size() - 1);
+    SwitchToWorkspaceImpl(workspaces_[index].id);
+    if (pref_service_->GetString(prefs::kHeliumWorkspacesLastActive) ==
+        deleted_ids.back()) {
+      pref_service_->SetString(prefs::kHeliumWorkspacesLastActive,
+                               active_workspace_id_);
+    }
+  }
+
+  for (const std::string& id : deleted_ids) {
+    stashes_.erase(id);
+    UpdateSessionForWorkspace(id);
+  }
+
+  NotifyChanged();
+}
+
+void WorkspaceController::SwitchToWorkspaceImpl(const std::string& id) {
+  TabStripModel* const model = browser_->GetTabStripModel();
+  if (switching_ || model->closing_all()) {
+    return;
+  }
+
+  base::AutoReset<bool> switching(&switching_, true);
+  std::unique_ptr<tab_groups::ScopedLocalObservationPauser> pauser =
+      PauseTabGroupSync(browser_->GetProfile());
+
+  const std::vector<tabs::TabInterface*> old_tabs = GetWorkspaceTabs();
+  tabs::TabInterface* const old_active_tab = model->GetActiveTab();
+
+  // Insert the tabs of the new workspace before removing the old ones, so the
+  // tab strip is never empty.
+  Stash new_stash;
+  if (auto it = stashes_.find(id); it != stashes_.end()) {
+    new_stash = std::move(it->second);
+    stashes_.erase(it);
+  }
+  tabs::TabInterface* tab_to_activate = InsertStash(std::move(new_stash));
+  if (!tab_to_activate) {
+    chrome::AddTabAt(browser_, GURL(), model->count(), /*foreground=*/true);
+    tab_to_activate = model->GetActiveTab();
+  }
+  if (tab_to_activate && model->GetIndexOfTab(tab_to_activate) !=
+                             TabStripModel::kNoTab) {
+    model->ActivateTab(tab_to_activate);
+  }
+
+  Stash old_stash = DetachTabs(old_tabs, old_active_tab);
+  const std::string old_id = active_workspace_id_;
+  if (!old_stash.items.empty()) {
+    stashes_[old_id] = std::move(old_stash);
+  }
+  active_workspace_id_ = id;
+
+  UpdateSessionForWorkspace(old_id);
+  UpdateSessionForWorkspace(id);
+  UpdateSessionActiveWorkspace();
+}
+
+tabs::TabInterface* WorkspaceController::InsertStash(Stash stash) {
+  TabStripModel* const model = browser_->GetTabStripModel();
+  std::vector<tabs::TabInterface*> inserted_tabs;
+
+  const auto add_pending_tab =
+      [&](const PendingTab& tab,
+          std::optional<tab_groups::TabGroupId> group) {
+        sessions::SerializedNavigationEntry entry;
+        const GURL url =
+            tab.url.is_valid() ? tab.url : GURL(chrome::kChromeUINewTabURL);
+        entry.set_index(0);
+        entry.set_virtual_url(url);
+        entry.set_original_request_url(url);
+        entry.set_title(tab.title);
+        entry.set_transition_type(ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+        entry.set_timestamp(base::Time::Now());
+        content::WebContents* const contents = chrome::AddRestoredTab(
+            browser_, base::span_from_ref(entry), model->count(),
+            /*selected_navigation=*/0, /*extension_app_id=*/std::string(),
+            group, /*select=*/false, /*pin=*/false, base::TimeTicks(),
+            base::Time(), /*storage_namespace=*/nullptr,
+            sessions::SerializedUserAgentOverride(), /*extra_data=*/{},
+            /*from_session_restore=*/false, /*is_active_browser=*/std::nullopt,
+            chrome::RestoredTabLoadPolicy::kDeferUntilActivation);
+        if (tabs::TabInterface* const inserted =
+                contents ? tabs::TabInterface::MaybeGetFromContents(contents)
+                         : nullptr) {
+          inserted_tabs.push_back(inserted);
+        }
+      };
+
+  for (StashedItem& item : stash.items) {
+    if (auto* tab = std::get_if<std::unique_ptr<tabs::TabModel>>(&item)) {
+      tabs::TabInterface* const tab_interface = tab->get();
+      model->InsertDetachedTabAt(model->count(), std::move(*tab),
+                                 AddTabTypes::ADD_NONE);
+      inserted_tabs.push_back(tab_interface);
+    } else if (auto* collection =
+                   std::get_if<std::unique_ptr<DetachedTabCollection>>(
+                       &item)) {
+      std::vector<tabs::TabInterface*> collection_tabs;
+      std::visit(
+          [&collection_tabs](const auto& tab_collection) {
+            collection_tabs = tab_collection->GetTabsRecursive();
+          },
+          (*collection)->collection_);
+      if (std::holds_alternative<std::unique_ptr<tabs::TabGroupTabCollection>>(
+              (*collection)->collection_)) {
+        model->InsertDetachedTabGroupAt(std::move(*collection),
+                                        model->count());
+      } else {
+        model->InsertDetachedSplitTabAt(std::move(*collection), model->count(),
+                                        /*pinned=*/false);
+      }
+      std::ranges::copy(collection_tabs, std::back_inserter(inserted_tabs));
+    } else if (auto* pending_tab = std::get_if<PendingTab>(&item)) {
+      add_pending_tab(*pending_tab, std::nullopt);
+    } else if (auto* pending_group = std::get_if<PendingGroup>(&item)) {
+      if (!model->SupportsTabGroups()) {
+        for (const PendingTab& group_tab : pending_group->tabs) {
+          add_pending_tab(group_tab, std::nullopt);
+        }
+        continue;
+      }
+      const tab_groups::TabGroupId group_id =
+          tab_groups::TabGroupId::GenerateNew();
+      for (const PendingTab& group_tab : pending_group->tabs) {
+        add_pending_tab(group_tab, group_id);
+      }
+      if (model->group_model()->ContainsTabGroup(group_id)) {
+        model->ChangeTabGroupVisuals(group_id, pending_group->visual_data);
+      }
+    }
+  }
+
+  if (inserted_tabs.empty()) {
+    return nullptr;
+  }
+
+  if (tabs::TabInterface* const active_tab = stash.active_tab.Get();
+      active_tab && base::Contains(inserted_tabs, active_tab)) {
+    return active_tab;
+  }
+  if (stash.pending_active_index &&
+      *stash.pending_active_index >= 0 &&
+      *stash.pending_active_index < static_cast<int>(inserted_tabs.size())) {
+    return inserted_tabs[*stash.pending_active_index];
+  }
+  return inserted_tabs.front();
+}
+
+WorkspaceController::Stash WorkspaceController::DetachTabs(
+    const std::vector<tabs::TabInterface*>& tabs,
+    tabs::TabInterface* active_tab) {
+  TabStripModel* const model = browser_->GetTabStripModel();
+  Stash stash;
+  if (active_tab && base::Contains(tabs, active_tab)) {
+    stash.active_tab = active_tab->GetHandle();
+  }
+
+  std::vector<int> indices;
+  for (const tabs::TabInterface* tab : tabs) {
+    const int index = model->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab) {
+      indices.push_back(index);
+    }
+  }
+  std::ranges::sort(indices);
+  if (indices.empty()) {
+    return stash;
+  }
+
+  for (auto& detached : model->DetachTabsAndCollectionsForInsertion(indices)) {
+    if (auto* tab = std::get_if<std::unique_ptr<DetachedTab>>(&detached)) {
+      stash.items.emplace_back(std::move((*tab)->tab));
+    } else {
+      stash.items.emplace_back(
+          std::move(std::get<std::unique_ptr<DetachedTabCollection>>(detached)));
+    }
+  }
+  return stash;
+}
+
+std::vector<tabs::TabInterface*> WorkspaceController::GetWorkspaceTabs()
+    const {
+  std::vector<tabs::TabInterface*> tabs;
+  for (tabs::TabInterface* tab : *browser_->GetTabStripModel()) {
+    if (!tab->IsPinned()) {
+      tabs.push_back(tab);
+    }
+  }
+  return tabs;
+}
+
+bool WorkspaceController::HasStashedTabs() const {
+  return std::ranges::any_of(stashes_, [](const auto& entry) {
+    return !entry.second.items.empty();
+  });
+}
+
+void WorkspaceController::OpenNewTabIfEmpty() {
+  TabStripModel* const model = browser_->GetTabStripModel();
+  if (!model->empty() || model->closing_all() ||
+      browser_->IsDeleteScheduled()) {
+    return;
+  }
+  chrome::AddTabAt(browser_, GURL(), -1, /*foreground=*/true);
+}
+
+std::string WorkspaceController::SerializeStash(const Stash& stash) const {
+  base::ListValue items;
+  int tab_index = 0;
+  std::optional<int> active_index;
+  const tabs::TabInterface* const active_tab = stash.active_tab.Get();
+
+  const auto add_tab = [&](base::ListValue& list, base::DictValue tab,
+                           bool active) {
+    if (active) {
+      active_index = tab_index;
+    }
+    list.Append(std::move(tab));
+    ++tab_index;
+  };
+
+  for (const StashedItem& item : stash.items) {
+    if (const auto* tab = std::get_if<std::unique_ptr<tabs::TabModel>>(&item)) {
+      add_tab(items, SerializeTab(tab->get()), tab->get() == active_tab);
+    } else if (const auto* collection =
+                   std::get_if<std::unique_ptr<DetachedTabCollection>>(
+                       &item)) {
+      if (const auto* group_collection =
+              std::get_if<std::unique_ptr<tabs::TabGroupTabCollection>>(
+                  &(*collection)->collection_)) {
+        base::ListValue group_tabs;
+        for (const tabs::TabInterface* group_tab :
+             (*group_collection)->GetTabsRecursive()) {
+          add_tab(group_tabs, SerializeTab(group_tab), group_tab == active_tab);
+        }
+        items.Append(SerializeGroup(
+            *(*group_collection)->GetTabGroup()->visual_data(),
+            std::move(group_tabs)));
+      } else {
+        // Split tabs are restored as separate tabs.
+        std::visit(
+            [&](const auto& tab_collection) {
+              for (const tabs::TabInterface* split_tab :
+                   tab_collection->GetTabsRecursive()) {
+                add_tab(items, SerializeTab(split_tab),
+                        split_tab == active_tab);
+              }
+            },
+            (*collection)->collection_);
+      }
+    } else if (const auto* pending_tab = std::get_if<PendingTab>(&item)) {
+      add_tab(items, SerializeTab(pending_tab->url, pending_tab->title),
+              stash.pending_active_index == tab_index);
+    } else if (const auto* pending_group = std::get_if<PendingGroup>(&item)) {
+      base::ListValue group_tabs;
+      for (const PendingTab& group_tab : pending_group->tabs) {
+        add_tab(group_tabs, SerializeTab(group_tab.url, group_tab.title),
+                stash.pending_active_index == tab_index);
+      }
+      items.Append(
+          SerializeGroup(pending_group->visual_data, std::move(group_tabs)));
+    }
+  }
+
+  if (items.empty()) {
+    return std::string();
+  }
+
+  // Drop tabs from the end until the data is small enough to save.
+  while (!items.empty()) {
+    base::DictValue dict;
+    dict.Set(kItemsKey, items.Clone());
+    if (active_index) {
+      dict.Set(kActiveKey, *active_index);
+    }
+    std::optional<std::string> json = base::WriteJson(dict);
+    if (json && json->size() <= kMaxSessionDataSize) {
+      return *std::move(json);
+    }
+    items.erase(items.end() - 1);
+  }
+  return std::string();
+}
+
+std::optional<WorkspaceController::Stash>
+WorkspaceController::DeserializeStash(const std::string& data) const {
+  if (data.empty()) {
+    return std::nullopt;
+  }
+
+  std::optional<base::Value> value = base::JSONReader::Read(
+      data, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  const base::ListValue* const items = value->GetDict().FindList(kItemsKey);
+  if (!items) {
+    return std::nullopt;
+  }
+
+  const auto parse_tab = [](const base::Value& tab_value)
+      -> std::optional<PendingTab> {
+    if (!tab_value.is_dict()) {
+      return std::nullopt;
+    }
+    PendingTab tab;
+    if (const std::string* const url = tab_value.GetDict().FindString(kUrlKey)) {
+      tab.url = GURL(*url);
+    }
+    if (const std::string* const title =
+            tab_value.GetDict().FindString(kTitleKey)) {
+      tab.title = base::UTF8ToUTF16(*title);
+    }
+    return tab;
+  };
+
+  Stash stash;
+  for (const base::Value& item : *items) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const base::DictValue* const group = item.GetDict().FindDict(kGroupKey);
+    if (!group) {
+      if (std::optional<PendingTab> tab = parse_tab(item)) {
+        stash.items.emplace_back(*std::move(tab));
+      }
+      continue;
+    }
+
+    PendingGroup pending_group;
+    const std::string* const title = group->FindString(kTitleKey);
+    const int color = group->FindInt(kColorKey).value_or(0);
+    pending_group.visual_data = tab_groups::TabGroupVisualData(
+        title ? base::UTF8ToUTF16(*title) : std::u16string(),
+        static_cast<tab_groups::TabGroupColorId>(std::clamp(
+            color, 0,
+            static_cast<int>(tab_groups::TabGroupColorId::kNumEntries) - 1)),
+        group->FindBool(kCollapsedKey).value_or(false));
+    if (const base::ListValue* const tabs = item.GetDict().FindList(kTabsKey)) {
+      for (const base::Value& tab_value : *tabs) {
+        if (std::optional<PendingTab> tab = parse_tab(tab_value)) {
+          pending_group.tabs.push_back(*std::move(tab));
+        }
+      }
+    }
+    if (!pending_group.tabs.empty()) {
+      stash.items.emplace_back(std::move(pending_group));
+    }
+  }
+  stash.pending_active_index = value->GetDict().FindInt(kActiveKey);
+  return stash;
+}
+
+void WorkspaceController::UpdateSessionForWorkspace(const std::string& id) {
+  if (!CanUpdateSession()) {
+    return;
+  }
+
+  const auto it = stashes_.find(id);
+  const std::string key = kWorkspaceTabsKeyPrefix + id;
+  session_service_->AddWindowExtraData(
+      browser_->GetSessionID(), key.c_str(),
+      it != stashes_.end() ? SerializeStash(it->second) : std::string());
+}
+
+void WorkspaceController::UpdateSessionActiveWorkspace() {
+  if (!CanUpdateSession()) {
+    return;
+  }
+
+  session_service_->AddWindowExtraData(
+      browser_->GetSessionID(), kActiveWorkspaceKey, active_workspace_id_);
+}
+
+bool WorkspaceController::CanUpdateSession() const {
+  return session_service_ && !browser_collection_observation_.IsObserving();
+}
+
+void WorkspaceController::NotifyChanged() {
+  on_changed_callbacks_.Notify();
+}
