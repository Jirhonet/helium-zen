+#include "ui/events/event.h"
+#include "ui/gfx/text_constants.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/button/button_controller.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/menu/menu_runner.h"
+#include "ui/views/controls/menu/menu_types.h"
+
+namespace {
+
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kWorkspaceNameTextfieldId);
+
+enum Command {
+  kNewWorkspace = 1,
+  kRenameWorkspace,
+  kMoveWorkspaceUp,
+  kMoveWorkspaceDown,
+  kDeleteWorkspace,
+  // Commands to switch to a workspace start here, one per workspace.
+  kFirstWorkspace = 1000,
+};
+
+// The widest the toolbar button gets before its name is elided.
+constexpr int kMaxToolbarWidth = 200;
+
+// The narrowest the vertical tab strip button can be while showing the name,
+// e.g. while the vertical tab strip is collapsed.
+constexpr int kMinWidthForLabel = 100;
+
+// Reads the name from the name dialog and passes it on when it is accepted.
+class NameDialogDelegate : public ui::DialogModelDelegate {
+ public:
+  explicit NameDialogDelegate(
+      base::OnceCallback<void(std::u16string)> on_accepted)
+      : on_accepted_(std::move(on_accepted)) {}
+
+  void OnDialogAccepted() {
+    const ui::DialogModelTextfield* const textfield =
+        dialog_model()->GetTextfieldByUniqueId(kWorkspaceNameTextfieldId);
+    std::u16string name;
+    base::TrimWhitespace(textfield->text(), base::TRIM_ALL, &name);
+    if (!name.empty() && on_accepted_) {
+      std::move(on_accepted_).Run(std::move(name));
+    }
+  }
+
+ private:
+  base::OnceCallback<void(std::u16string)> on_accepted_;
+};
+
+}  // namespace
+
+WorkspaceButton::WorkspaceButton(BrowserWindowInterface* browser, Style style)
+    : ToolbarButton(base::BindRepeating(&WorkspaceButton::ButtonPressed,
+                                        base::Unretained(this))),
+      browser_(browser),
+      style_(style) {
+  SetVectorIcon(kGridViewIcon);
+  label()->SetElideBehavior(gfx::ELIDE_TAIL);
+  if (style_ == Style::kToolbar) {
+    SetMaxSize(gfx::Size(kMaxToolbarWidth, 0));
+  }
+
+  // Open the menu on press, like other menu buttons.
+  button_controller()->set_notify_action(
+      views::ButtonController::NotifyAction::kOnPress);
+  GetViewAccessibility().SetRole(ax::mojom::Role::kPopUpButton);
+  GetViewAccessibility().SetHasPopup(ax::mojom::HasPopup::kMenu);
+
+  if (WorkspaceController* const controller = GetController()) {
+    controller_subscription_ = controller->RegisterOnChanged(base::BindRepeating(
+        &WorkspaceButton::UpdateState, base::Unretained(this)));
+  }
+  UpdateState();
+}
+
+WorkspaceButton::~WorkspaceButton() = default;
+
+bool WorkspaceButton::OnMouseWheel(const ui::MouseWheelEvent& event) {
+  WorkspaceController* const controller = GetController();
+  if (!controller) {
+    return ToolbarButton::OnMouseWheel(event);
+  }
+
+  const int offset = event.y_offset() ? event.y_offset() : event.x_offset();
+  if (offset == 0) {
+    return true;
+  }
+
+  // Start over when the direction changes.
+  if (scroll_offset_ != 0 && (scroll_offset_ > 0) != (offset > 0)) {
+    scroll_offset_ = 0;
+  }
+  scroll_offset_ += offset;
+
+  // Scrolling up goes to the previous workspace, down to the next one.
+  const int threshold = ui::MouseWheelEvent::kWheelDelta;
+  while (std::abs(scroll_offset_) >= threshold) {
+    const bool up = scroll_offset_ > 0;
+    scroll_offset_ += up ? -threshold : threshold;
+    controller->SwitchToAdjacentWorkspace(up ? -1 : 1);
+  }
+  return true;
+}
+
+void WorkspaceButton::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  ToolbarButton::OnBoundsChanged(previous_bounds);
+  if (bounds().width() != previous_bounds.width()) {
+    UpdateLabel();
+  }
+}
+
+void WorkspaceButton::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  if (!GetController()) {
+    return;
+  }
+
+  auto model = std::make_unique<ui::SimpleMenuModel>(this);
+  model->AddItemWithStringId(kRenameWorkspace,
+                             IDS_HELIUM_WORKSPACE_MENU_RENAME);
+  model->AddItemWithStringId(kNewWorkspace, IDS_HELIUM_WORKSPACE_MENU_NEW);
+  model->AddSeparator(ui::NORMAL_SEPARATOR);
+  model->AddItemWithStringId(kMoveWorkspaceUp,
+                             IDS_HELIUM_WORKSPACE_MENU_MOVE_UP);
+  model->AddItemWithStringId(kMoveWorkspaceDown,
+                             IDS_HELIUM_WORKSPACE_MENU_MOVE_DOWN);
+  model->AddSeparator(ui::NORMAL_SEPARATOR);
+  model->AddItemWithStringId(kDeleteWorkspace,
+                             IDS_HELIUM_WORKSPACE_MENU_DELETE);
+  ShowMenu(std::move(model), source_type);
+}
+
+bool WorkspaceButton::IsCommandIdChecked(int command_id) const {
+  const WorkspaceController* const controller = GetController();
+  const size_t index = static_cast<size_t>(command_id - kFirstWorkspace);
+  return controller && command_id >= kFirstWorkspace &&
+         index < menu_workspace_ids_.size() &&
+         menu_workspace_ids_[index] == controller->active_workspace_id();
+}
+
+bool WorkspaceButton::IsCommandIdEnabled(int command_id) const {
+  const WorkspaceController* const controller = GetController();
+  if (!controller) {
+    return false;
+  }
+
+  const std::string& active_id = controller->active_workspace_id();
+  switch (command_id) {
+    case kMoveWorkspaceUp:
+      return controller->CanMoveWorkspace(active_id, -1);
+    case kMoveWorkspaceDown:
+      return controller->CanMoveWorkspace(active_id, 1);
+    case kDeleteWorkspace:
+      return controller->CanDeleteWorkspace();
+    default:
+      return true;
+  }
+}
+
+void WorkspaceButton::ExecuteCommand(int command_id, int event_flags) {
+  WorkspaceController* const controller = GetController();
+  if (!controller) {
+    return;
+  }
+
+  const std::string active_id = controller->active_workspace_id();
+  switch (command_id) {
+    case kNewWorkspace:
+      ShowNameDialog(std::string());
+      return;
+    case kRenameWorkspace:
+      ShowNameDialog(active_id);
+      return;
+    case kMoveWorkspaceUp:
+      controller->MoveWorkspace(active_id, -1);
+      return;
+    case kMoveWorkspaceDown:
+      controller->MoveWorkspace(active_id, 1);
+      return;
+    case kDeleteWorkspace:
+      ShowDeleteDialog(active_id);
+      return;
+    default:
+      break;
+  }
+
+  const size_t index = static_cast<size_t>(command_id - kFirstWorkspace);
+  if (command_id >= kFirstWorkspace && index < menu_workspace_ids_.size()) {
+    controller->SwitchToWorkspace(menu_workspace_ids_[index]);
+  }
+}
+
+WorkspaceController* WorkspaceButton::GetController() const {
+  return WorkspaceController::From(browser_);
+}
+
+void WorkspaceButton::ButtonPressed(const ui::Event& event) {
+  WorkspaceController* const controller = GetController();
+  if (!controller) {
+    return;
+  }
+
+  auto model = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_workspace_ids_.clear();
+  for (const WorkspaceController::Workspace& workspace :
+       controller->workspaces()) {
+    model->AddRadioItem(
+        kFirstWorkspace + static_cast<int>(menu_workspace_ids_.size()),
+        workspace.name, /*group_id=*/0);
+    menu_workspace_ids_.push_back(workspace.id);
+  }
+  model->AddSeparator(ui::NORMAL_SEPARATOR);
+  model->AddItemWithStringId(kNewWorkspace, IDS_HELIUM_WORKSPACE_MENU_NEW);
+
+  ShowMenu(std::move(model), ui::GetMenuSourceTypeForEvent(event));
+}
+
+void WorkspaceButton::UpdateState() {
+  const WorkspaceController* const controller = GetController();
+  const WorkspaceController::Workspace* const workspace =
+      controller ? controller->GetActiveWorkspace() : nullptr;
+  workspace_name_ = workspace ? workspace->name : std::u16string();
+
+  const std::u16string tooltip = l10n_util::GetStringFUTF16(
+      IDS_HELIUM_WORKSPACE_BUTTON_TOOLTIP, workspace_name_);
+  SetTooltipText(tooltip);
+  GetViewAccessibility().SetName(tooltip);
+
+  // Force the label to update.
+  show_label_ = !show_label_;
+  UpdateLabel();
+}
+
+void WorkspaceButton::UpdateLabel() {
+  const bool show_label = style_ == Style::kToolbar || width() == 0 ||
+                          width() >= kMinWidthForLabel;
+  if (show_label == show_label_ &&
+      GetText() == (show_label ? workspace_name_ : std::u16string())) {
+    return;
+  }
+
+  show_label_ = show_label;
+  SetText(show_label ? workspace_name_ : std::u16string());
+  SetHorizontalAlignment(style_ == Style::kVerticalTabStrip && show_label
+                             ? gfx::ALIGN_LEFT
+                             : gfx::ALIGN_CENTER);
+}
+
+void WorkspaceButton::ShowMenu(std::unique_ptr<ui::SimpleMenuModel> model,
+                               ui::mojom::MenuSourceType source_type) {
+  if (!GetWidget()) {
+    return;
+  }
+
+  workspace_menu_model_ = std::move(model);
+  workspace_menu_runner_ = std::make_unique<views::MenuRunner>(
+      workspace_menu_model_.get(), views::MenuRunner::NO_FLAGS,
+      base::BindRepeating(&WorkspaceButton::OnMenuClosed,
+                          weak_ptr_factory_.GetWeakPtr()));
+  workspace_menu_runner_->RunMenuAt(
+      GetWidget(), /*button_controller=*/nullptr, GetAnchorBoundsInScreen(),
+      views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void WorkspaceButton::OnMenuClosed() {
+  SetState(views::Button::STATE_NORMAL);
+}
+
+void WorkspaceButton::ShowNameDialog(const std::string& workspace_id) {
+  WorkspaceController* const controller = GetController();
+  if (!controller) {
+    return;
+  }
+
+  std::u16string name = controller->GetDefaultNameForNewWorkspace();
+  if (!workspace_id.empty()) {
+    const std::optional<size_t> index =
+        controller->GetWorkspaceIndex(workspace_id);
+    if (!index) {
+      return;
+    }
+    name = controller->workspaces()[*index].name;
+  }
+
+  const bool is_new = workspace_id.empty();
+  auto on_accepted = base::BindOnce(
+      [](base::WeakPtr<WorkspaceButton> button, std::string workspace_id,
+         std::u16string name) {
+        WorkspaceController* const controller =
+            button ? button->GetController() : nullptr;
+        if (!controller) {
+          return;
+        }
+        if (workspace_id.empty()) {
+          controller->CreateWorkspace(name);
+        } else {
+          controller->RenameWorkspace(workspace_id, name);
+        }
+      },
+      weak_ptr_factory_.GetWeakPtr(), workspace_id);
+
+  auto delegate = std::make_unique<NameDialogDelegate>(std::move(on_accepted));
+  NameDialogDelegate* const delegate_ptr = delegate.get();
+  const std::u16string label =
+      l10n_util::GetStringUTF16(IDS_HELIUM_WORKSPACE_NAME_LABEL);
+  auto dialog_model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(l10n_util::GetStringUTF16(
+              is_new ? IDS_HELIUM_WORKSPACE_NEW_DIALOG_TITLE
+                     : IDS_HELIUM_WORKSPACE_RENAME_DIALOG_TITLE))
+          .AddTextfield(
+              kWorkspaceNameTextfieldId, label, name,
+              ui::DialogModelTextfield::Params().SetAccessibleName(label))
+          .AddOkButton(
+              base::BindOnce(&NameDialogDelegate::OnDialogAccepted,
+                             base::Unretained(delegate_ptr)),
+              ui::DialogModel::Button::Params().SetLabel(
+                  l10n_util::GetStringUTF16(
+                      is_new ? IDS_HELIUM_WORKSPACE_CREATE_BUTTON
+                             : IDS_HELIUM_WORKSPACE_RENAME_BUTTON)))
+          .AddCancelButton(base::DoNothing())
+          .SetInitiallyFocusedField(kWorkspaceNameTextfieldId)
+          .Build();
+  constrained_window::ShowBrowserModal(std::move(dialog_model),
+                                       browser_->GetWindow()->GetNativeWindow());
+}
+
+void WorkspaceButton::ShowDeleteDialog(const std::string& workspace_id) {
+  WorkspaceController* const controller = GetController();
+  const std::optional<size_t> index =
+      controller ? controller->GetWorkspaceIndex(workspace_id) : std::nullopt;
+  if (!index || !controller->CanDeleteWorkspace()) {
+    return;
+  }
+
+  auto on_accepted = base::BindOnce(
+      [](base::WeakPtr<WorkspaceButton> button, std::string workspace_id) {
+        if (WorkspaceController* const controller =
+                button ? button->GetController() : nullptr) {
+          controller->DeleteWorkspace(workspace_id);
+        }
+      },
+      weak_ptr_factory_.GetWeakPtr(), workspace_id);
+
+  auto dialog_model =
+      ui::DialogModel::Builder()
+          .SetTitle(l10n_util::GetStringFUTF16(
+              IDS_HELIUM_WORKSPACE_DELETE_DIALOG_TITLE,
+              controller->workspaces()[*index].name))
+          .AddParagraph(ui::DialogModelLabel(
+              IDS_HELIUM_WORKSPACE_DELETE_DIALOG_BODY))
+          .AddOkButton(std::move(on_accepted),
+                       ui::DialogModel::Button::Params().SetLabel(
+                           l10n_util::GetStringUTF16(
+                               IDS_HELIUM_WORKSPACE_DELETE_BUTTON)))
+          .AddCancelButton(base::DoNothing())
+          .OverrideDefaultButton(ui::mojom::DialogButton::kCancel)
+          .Build();
+  constrained_window::ShowBrowserModal(std::move(dialog_model),
+                                       browser_->GetWindow()->GetNativeWindow());
+}
