+// Workspaces pref keys.
+constexpr char kIdKey[] = "id";
+constexpr char kNameKey[] = "name";
+
+// Session data keys.
+constexpr char kItemsKey[] = "items";
+constexpr char kActiveKey[] = "active";
+constexpr char kUrlKey[] = "url";
+constexpr char kTitleKey[] = "title";
+constexpr char kGroupKey[] = "group";
+constexpr char kColorKey[] = "color";
+constexpr char kCollapsedKey[] = "collapsed";
+constexpr char kTabsKey[] = "tabs";
+
+// A session command can't be larger than 64 KiB, so the data of a workspace
+// is kept well below that. Tabs that don't fit are not saved.
+constexpr size_t kMaxSessionDataSize = 48 * 1024;
+constexpr size_t kMaxUrlLength = 2 * 1024;
+constexpr size_t kMaxTitleLength = 256;
+
+base::ListValue SerializeWorkspaces(
+    const std::vector<WorkspaceController::Workspace>& workspaces) {
+  base::ListValue list;
+  for (const WorkspaceController::Workspace& workspace : workspaces) {
+    base::DictValue dict;
+    dict.Set(kIdKey, workspace.id);
+    dict.Set(kNameKey, workspace.name);
+    list.Append(std::move(dict));
+  }
+  return list;
+}
+
+std::unique_ptr<tab_groups::ScopedLocalObservationPauser> PauseTabGroupSync(
+    Profile* profile) {
+  tab_groups::TabGroupSyncService* const service =
+      tab_groups::TabGroupSyncServiceFactory::GetForProfile(profile);
+  return service ? service->CreateScopedLocalObserverPauser() : nullptr;
+}
+
+base::DictValue SerializeTab(const GURL& url, std::u16string title) {
+  base::DictValue dict;
+  // Tabs with URLs that are too long to save, e.g. data URLs, are restored as
+  // a new tab page.
+  if (url.is_valid() && url.spec().size() <= kMaxUrlLength) {
+    dict.Set(kUrlKey, url.spec());
+  }
+  if (title.size() > kMaxTitleLength) {
+    title.resize(kMaxTitleLength);
+  }
+  dict.Set(kTitleKey, title);
+  return dict;
+}
+
+base::DictValue SerializeTab(const tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab->GetContents();
+  content::NavigationController& controller = contents->GetController();
+  content::NavigationEntry* entry = controller.GetLastCommittedEntry();
+  if (!entry || entry->IsInitialEntry()) {
+    entry = controller.GetVisibleEntry();
+  }
+  return entry ? SerializeTab(entry->GetVirtualURL(), entry->GetTitle())
+               : SerializeTab(contents->GetVisibleURL(), contents->GetTitle());
+}
+
+base::DictValue SerializeGroup(const tab_groups::TabGroupVisualData& visual_data,
+                               base::ListValue tabs) {
+  base::DictValue group;
+  group.Set(kTitleKey, visual_data.title());
+  group.Set(kColorKey, static_cast<int>(visual_data.color()));
+  group.Set(kCollapsedKey, visual_data.is_collapsed());
+
+  base::DictValue dict;
+  dict.Set(kGroupKey, std::move(group));
+  dict.Set(kTabsKey, std::move(tabs));
+  return dict;
+}
