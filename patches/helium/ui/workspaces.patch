+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_WORKSPACE_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_WORKSPACE_BUTTON_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_button.h"
