+// A workspace separates the unpinned tabs and tab groups of a window into
+// their own space. The list of workspaces is shared by all windows of a
+// profile, while each window has its own active workspace and its own tabs in
+// every workspace. Pinned tabs are shown in all workspaces.
+//
+// Only the tabs of the active workspace are in the tab strip. The tabs of the
+// other workspaces are kept alive, detached from the tab strip, until their
+// workspace is activated again. They are saved with the window's session, and
+// are restored without loading when their workspace is activated.
+class WorkspaceController : public SessionServiceBaseObserver,
+                            public BrowserCollectionObserver {
+ public:
+  DECLARE_USER_DATA(WorkspaceController);
+
+  struct Workspace {
+    std::string id;
+    std::u16string name;
+  };
+
+  // Window session extra data keys.
+  static constexpr char kActiveWorkspaceKey[] = "helium.workspaces.active";
+  static constexpr char kWorkspaceTabsKeyPrefix[] = "helium.workspaces.tabs.";
+
+  WorkspaceController(BrowserWindowInterface* browser,
+                      PrefService* pref_service,
+                      SessionService* session_service);
+  WorkspaceController(const WorkspaceController&) = delete;
+  WorkspaceController& operator=(const WorkspaceController&) = delete;
+  ~WorkspaceController() override;
+
+  static WorkspaceController* From(BrowserWindowInterface* browser);
+
+  // Returns the workspaces of the profile, in display order.
+  const std::vector<Workspace>& workspaces() const { return workspaces_; }
+  const std::string& active_workspace_id() const {
+    return active_workspace_id_;
+  }
+  std::optional<size_t> GetWorkspaceIndex(const std::string& id) const;
+  const Workspace* GetActiveWorkspace() const;
+
+  // Returns a name for a new workspace, e.g. "Workspace 2".
+  std::u16string GetDefaultNameForNewWorkspace() const;
+
+  // Shows the tabs of the workspace with `id` in this window.
+  void SwitchToWorkspace(const std::string& id);
+
+  // Activates the next (`delta` > 0) or previous (`delta` < 0) workspace.
+  void SwitchToAdjacentWorkspace(int delta);
+
+  // Adds a workspace at the end of the list and activates it in this window.
+  void CreateWorkspace(const std::u16string& name);
+
+  void RenameWorkspace(const std::string& id, const std::u16string& name);
+
+  // Moves the workspace with `id` `delta` places in the list.
+  void MoveWorkspace(const std::string& id, int delta);
+  bool CanMoveWorkspace(const std::string& id, int delta) const;
+
+  // Removes the workspace with `id` and closes its tabs in all windows. The
+  // last workspace can't be deleted.
+  void DeleteWorkspace(const std::string& id);
+  bool CanDeleteWorkspace() const { return workspaces_.size() > 1; }
+
+  // Restores the active workspace and the tabs of the other workspaces from
+  // the window's session data. Called before the window's tabs are restored.
+  void RestoreFromSession(const std::map<std::string, std::string>& extra_data);
+
+  // Returns the window session extra data for the workspaces of this window.
+  std::map<std::string, std::string> GetSessionExtraData() const;
+
+  // Called when the last tab of the tab strip was removed. Returns true if the
+  // window should stay open because other workspaces still have tabs. A new tab
+  // is opened in the active workspace in that case.
+  bool HandleTabStripEmpty();
+
+  // Called when the list of workspaces, their names or the active workspace
+  // changed.
+  base::CallbackListSubscription RegisterOnChanged(
+      base::RepeatingClosure callback);
+
+  // SessionServiceBaseObserver:
+  void OnDestroying(SessionServiceBase* service) override;
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+
+ private:
+  // A tab that was restored from the session, but not created yet.
+  struct PendingTab {
+    GURL url;
+    std::u16string title;
+  };
+
+  // A tab group whose tabs were restored from the session.
+  struct PendingGroup {
+    PendingGroup();
+    PendingGroup(PendingGroup&&);
+    PendingGroup& operator=(PendingGroup&&);
+    ~PendingGroup();
+
+    tab_groups::TabGroupVisualData visual_data;
+    std::vector<PendingTab> tabs;
+  };
+
+  using StashedItem = std::variant<std::unique_ptr<tabs::TabModel>,
+                                   std::unique_ptr<DetachedTabCollection>,
+                                   PendingTab,
+                                   PendingGroup>;
+
+  // The tabs of a workspace that is not active in this window.
+  struct Stash {
+    Stash();
+    Stash(Stash&&);
+    Stash& operator=(Stash&&);
+    ~Stash();
+
+    std::vector<StashedItem> items;
+
+    // The tab that was active when the workspace was left.
+    tabs::TabHandle active_tab;
+
+    // The index of the active tab among the pending tabs, if the workspace was
+    // restored from the session.
+    std::optional<int> pending_active_index;
+  };
+
+  void LoadWorkspacesFromPrefs();
+  void SaveWorkspacesToPrefs();
+  void OnWorkspacesPrefChanged();
+
+  // Moves the unpinned tabs of the active workspace into a stash and inserts
+  // the tabs of `id`.
+  void SwitchToWorkspaceImpl(const std::string& id);
+
+  // Inserts the tabs of `stash` at the end of the tab strip, and returns the
+  // tab to activate.
+  tabs::TabInterface* InsertStash(Stash stash);
+
+  // Detaches `tabs` and returns them as a stash.
+  Stash DetachTabs(const std::vector<tabs::TabInterface*>& tabs,
+                   tabs::TabInterface* active_tab);
+
+  // Returns the unpinned tabs in the tab strip.
+  std::vector<tabs::TabInterface*> GetWorkspaceTabs() const;
+
+  bool HasStashedTabs() const;
+  void OpenNewTabIfEmpty();
+
+  std::string SerializeStash(const Stash& stash) const;
+  std::optional<Stash> DeserializeStash(const std::string& data) const;
+
+  // Writes the session data of the workspace with `id`.
+  void UpdateSessionForWorkspace(const std::string& id);
+  void UpdateSessionActiveWorkspace();
+  bool CanUpdateSession() const;
+
+  void NotifyChanged();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<PrefService> pref_service_;
+  raw_ptr<SessionService> session_service_;
+  PrefChangeRegistrar pref_change_registrar_;
+
+  std::vector<Workspace> workspaces_;
+  std::string active_workspace_id_;
+  std::map<std::string, Stash> stashes_;
+
+  // Set while this controller changes the workspaces pref.
+  bool updating_prefs_ = false;
+  // Set while tabs are moved in or out of the tab strip.
+  bool switching_ = false;
+
+  base::RepeatingClosureList on_changed_callbacks_;
+
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      browser_collection_observation_{this};
+
+  ui::ScopedUnownedUserData<WorkspaceController> scoped_unowned_user_data_;
+
+  base::WeakPtrFactory<WorkspaceController> weak_ptr_factory_{this};
+};
