+WorkspaceController::WorkspaceController(BrowserWindowInterface* browser,
+                                         PrefService* pref_service,
+                                         SessionService* session_service)
+    : browser_(browser),
+      pref_service_(pref_service),
+      session_service_(session_service),
+      scoped_unowned_user_data_(browser->GetUnownedUserDataHost(), *this) {
+  LoadWorkspacesFromPrefs();
+
+  // New windows start in the workspace that was used last.
+  const std::string& last_active =
+      pref_service_->GetString(prefs::kHeliumWorkspacesLastActive);
+  active_workspace_id_ = GetWorkspaceIndex(last_active)
+                             ? last_active
+                             : workspaces_.front().id;
+
+  pref_change_registrar_.Init(pref_service_);
+  pref_change_registrar_.Add(
+      prefs::kHeliumWorkspaces,
+      base::BindRepeating(&WorkspaceController::OnWorkspacesPrefChanged,
+                          base::Unretained(this)));
+
+  if (session_service_) {
+    session_service_->AddObserver(this);
+    // The session service only accepts data for the window once it was
+    // created.
+    browser_collection_observation_.Observe(
+        GlobalBrowserCollection::GetInstance());
+  }
+}
+
+WorkspaceController::~WorkspaceController() {
+  if (session_service_) {
+    session_service_->RemoveObserver(this);
+    session_service_ = nullptr;
+  }
+}
+
+// static
+WorkspaceController* WorkspaceController::From(
+    BrowserWindowInterface* browser) {
+  return browser ? Get(browser->GetUnownedUserDataHost()) : nullptr;
+}
+
+std::optional<size_t> WorkspaceController::GetWorkspaceIndex(
+    const std::string& id) const {
+  for (size_t i = 0; i < workspaces_.size(); ++i) {
+    if (workspaces_[i].id == id) {
+      return i;
+    }
+  }
+  return std::nullopt;
+}
+
+const WorkspaceController::Workspace* WorkspaceController::GetActiveWorkspace()
+    const {
+  const std::optional<size_t> index = GetWorkspaceIndex(active_workspace_id_);
+  return index ? &workspaces_[*index] : nullptr;
+}
+
+std::u16string WorkspaceController::GetDefaultNameForNewWorkspace() const {
+  for (size_t number = workspaces_.size() + 1;; ++number) {
+    std::u16string name = l10n_util::GetStringFUTF16Int(
+        IDS_HELIUM_WORKSPACE_NEW_NAME, static_cast<int>(number));
+    if (std::ranges::none_of(workspaces_, [&name](const Workspace& workspace) {
+          return workspace.name == name;
+        })) {
+      return name;
+    }
+  }
+}
+
+void WorkspaceController::SwitchToWorkspace(const std::string& id) {
+  if (id == active_workspace_id_ || !GetWorkspaceIndex(id)) {
+    return;
+  }
+
+  SwitchToWorkspaceImpl(id);
+  pref_service_->SetString(prefs::kHeliumWorkspacesLastActive, id);
+  NotifyChanged();
+}
+
+void WorkspaceController::SwitchToAdjacentWorkspace(int delta) {
+  const std::optional<size_t> index = GetWorkspaceIndex(active_workspace_id_);
+  if (!index || delta == 0) {
+    return;
+  }
+
+  const int target = static_cast<int>(*index) + delta;
+  if (target < 0 || target >= static_cast<int>(workspaces_.size())) {
+    return;
+  }
+  SwitchToWorkspace(workspaces_[target].id);
+}
+
+void WorkspaceController::CreateWorkspace(const std::u16string& name) {
+  Workspace workspace;
+  workspace.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  workspace.name = name.empty() ? GetDefaultNameForNewWorkspace() : name;
+  const std::string id = workspace.id;
+  workspaces_.push_back(std::move(workspace));
+  SaveWorkspacesToPrefs();
+  SwitchToWorkspace(id);
+}
+
+void WorkspaceController::RenameWorkspace(const std::string& id,
+                                          const std::u16string& name) {
+  const std::optional<size_t> index = GetWorkspaceIndex(id);
+  if (!index || name.empty() || workspaces_[*index].name == name) {
+    return;
+  }
+
+  workspaces_[*index].name = name;
+  SaveWorkspacesToPrefs();
+  NotifyChanged();
+}
+
+bool WorkspaceController::CanMoveWorkspace(const std::string& id,
+                                           int delta) const {
+  const std::optional<size_t> index = GetWorkspaceIndex(id);
+  if (!index || delta == 0) {
+    return false;
+  }
+  const int target = static_cast<int>(*index) + delta;
+  return target >= 0 && target < static_cast<int>(workspaces_.size());
+}
+
+void WorkspaceController::MoveWorkspace(const std::string& id, int delta) {
+  if (!CanMoveWorkspace(id, delta)) {
+    return;
+  }
+
+  const size_t index = *GetWorkspaceIndex(id);
+  Workspace workspace = std::move(workspaces_[index]);
+  workspaces_.erase(workspaces_.begin() + index);
+  workspaces_.insert(workspaces_.begin() + (index + delta),
+                     std::move(workspace));
+  SaveWorkspacesToPrefs();
+  NotifyChanged();
+}
+
+void WorkspaceController::DeleteWorkspace(const std::string& id) {
+  const std::optional<size_t> index = GetWorkspaceIndex(id);
+  if (!index || !CanDeleteWorkspace()) {
+    return;
+  }
+
+  // Every window, including this one, closes the tabs of the workspace when it
+  // sees the pref change.
+  std::vector<Workspace> workspaces = workspaces_;
+  workspaces.erase(workspaces.begin() + *index);
+  pref_service_->SetList(prefs::kHeliumWorkspaces,
+                         SerializeWorkspaces(workspaces));
+}
+
+void WorkspaceController::RestoreFromSession(
+    const std::map<std::string, std::string>& extra_data) {
+  const auto active = extra_data.find(kActiveWorkspaceKey);
+  if (active != extra_data.end() && GetWorkspaceIndex(active->second)) {
+    active_workspace_id_ = active->second;
+  }
+
+  const std::string prefix = kWorkspaceTabsKeyPrefix;
+  for (const auto& [key, data] : extra_data) {
+    if (!key.starts_with(prefix)) {
+      continue;
+    }
+    const std::string id = key.substr(prefix.size());
+    if (id == active_workspace_id_ || !GetWorkspaceIndex(id)) {
+      continue;
+    }
+    std::optional<Stash> stash = DeserializeStash(data);
+    if (stash && !stash->items.empty()) {
+      stashes_[id] = *std::move(stash);
+    }
+  }
+
+  // The window may already be known to the session service, which then has
+  // the state of a new window.
+  UpdateSessionActiveWorkspace();
+  for (const auto& [id, stash] : stashes_) {
+    UpdateSessionForWorkspace(id);
+  }
+
+  NotifyChanged();
+}
+
+std::map<std::string, std::string> WorkspaceController::GetSessionExtraData()
+    const {
+  std::map<std::string, std::string> data;
+  data[kActiveWorkspaceKey] = active_workspace_id_;
+  for (const auto& [id, stash] : stashes_) {
+    data[kWorkspaceTabsKeyPrefix + id] = SerializeStash(stash);
+  }
+  return data;
+}
+
+bool WorkspaceController::HandleTabStripEmpty() {
+  TabStripModel* const model = browser_->GetTabStripModel();
+  if (switching_ || model->closing_all() || browser_->IsDeleteScheduled()) {
+    return false;
+  }
+
+  const UnloadController* const unload_controller =
+      UnloadController::From(browser_);
+  if (unload_controller && unload_controller->is_attempting_to_close_browser()) {
+    return false;
+  }
+
+  if (!HasStashedTabs()) {
+    return false;
+  }
+
+  // The tab strip can't be changed while it notifies its observers.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceController::OpenNewTabIfEmpty,
+                                weak_ptr_factory_.GetWeakPtr()));
+  return true;
+}
