+
+class BrowserWindowInterface;
+class WorkspaceController;
+
+namespace views {
+class MenuRunner;
+}
+
+// Shows the active workspace of the window. Clicking it opens a menu to switch
+// to another workspace, scrolling over it switches to the next or previous
+// workspace, and its context menu manages the active workspace.
+class WorkspaceButton : public ToolbarButton,
+                        public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(WorkspaceButton, ToolbarButton)
+
+ public:
+  enum class Style {
+    // In the toolbar, next to the navigation buttons.
+    kToolbar,
+    // Above the vertical tab strip, as wide as the tabs.
+    kVerticalTabStrip,
+  };
+
+  WorkspaceButton(BrowserWindowInterface* browser, Style style);
+  WorkspaceButton(const WorkspaceButton&) = delete;
+  WorkspaceButton& operator=(const WorkspaceButton&) = delete;
+  ~WorkspaceButton() override;
+
+  // ToolbarButton:
+  bool OnMouseWheel(const ui::MouseWheelEvent& event) override;
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override;
+  bool IsCommandIdEnabled(int command_id) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  WorkspaceController* GetController() const;
+
+  void ButtonPressed(const ui::Event& event);
+  void UpdateState();
+
+  // Shows the name only if there is enough room for it.
+  void UpdateLabel();
+
+  void ShowMenu(std::unique_ptr<ui::SimpleMenuModel> model,
+                ui::mojom::MenuSourceType source_type);
+  void OnMenuClosed();
+
+  // Asks for the name of a new workspace, or of the workspace with
+  // `workspace_id` if it is not empty.
+  void ShowNameDialog(const std::string& workspace_id);
+  void ShowDeleteDialog(const std::string& workspace_id);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const Style style_;
+
+  std::u16string workspace_name_;
+  bool show_label_ = true;
+
+  // The workspaces listed in the open menu, by index.
+  std::vector<std::string> menu_workspace_ids_;
+  std::unique_ptr<ui::SimpleMenuModel> workspace_menu_model_;
+  std::unique_ptr<views::MenuRunner> workspace_menu_runner_;
+
+  // Accumulated scroll offset, so that high-resolution scrolling switches one
+  // workspace per notch.
+  int scroll_offset_ = 0;
+
+  base::CallbackListSubscription controller_subscription_;
+
+  base::WeakPtrFactory<WorkspaceButton> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_WORKSPACE_BUTTON_H_
