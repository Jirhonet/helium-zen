+  // bar reach the web contents.
+  if (GetMirroredRect(*side_layout_slot_).Intersects(rect)) {
+    return true;
+  }
+  return side_floating_location_bar_bounds_ &&
+         GetMirroredRect(*side_floating_location_bar_bounds_).Intersects(rect);
+}
