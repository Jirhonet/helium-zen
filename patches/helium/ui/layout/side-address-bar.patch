+bool ToolbarView::CanUseSideLayout() const {
+  return display_mode_ == DisplayMode::kNormal && location_bar_view_ &&
+         !toolbar_webview_ && layout_manager_;
+}
+
+void ToolbarView::SetSideLayoutEnabled(bool enabled) {
+  enabled = enabled && CanUseSideLayout();
+  if (side_layout_enabled_ == enabled) {
+    return;
+  }
+
+  side_layout_enabled_ = enabled;
+  const views::View* const omnibox_view =
+      location_bar_view_->GetViewByID(VIEW_ID_OMNIBOX);
+  side_location_bar_expanded_ =
+      enabled && omnibox_view && omnibox_view->HasFocus();
+  if (!enabled) {
+    side_leading_exclusion_ = 0;
+    side_trailing_exclusion_ = 0;
+    side_exclusion_height_ = 0;
+    side_layout_slot_.reset();
+    side_floating_location_bar_bounds_.reset();
+  }
+
+  UpdateSideLayoutBackground();
+  PreferredSizeChanged();
+  SchedulePaint();
+}
+
+void ToolbarView::SetSideLayoutExclusion(int leading_width,
+                                         int trailing_width,
+                                         int height) {
+  if (side_leading_exclusion_ == leading_width &&
+      side_trailing_exclusion_ == trailing_width &&
+      side_exclusion_height_ == height) {
+    return;
+  }
+
+  side_leading_exclusion_ = leading_width;
+  side_trailing_exclusion_ = trailing_width;
+  side_exclusion_height_ = height;
+  PreferredSizeChanged();
+}
+
+void ToolbarView::SetSideLayoutGeometry(
+    const std::optional<gfx::Rect>& slot,
+    const std::optional<gfx::Rect>& floating_bounds) {
+  if (side_layout_slot_ == slot &&
+      side_floating_location_bar_bounds_ == floating_bounds) {
+    return;
+  }
+
+  side_layout_slot_ = slot;
+  side_floating_location_bar_bounds_ = floating_bounds;
+  InvalidateLayout();
+  SchedulePaint();
+}
+
+bool ToolbarView::IsSideLocationBarExpanded() const {
+  return side_layout_enabled_ && side_location_bar_expanded_;
+}
+
+int ToolbarView::GetSingleRowHeight() const {
+  const int interior_height =
+      layout_manager_ ? layout_manager_->interior_margin().height() : 0;
+  return std::max(location_bar_->PreferredSize().height(),
+                  GetBackForwardButtonSize().height()) +
+         interior_height;
+}
+
+void ToolbarView::SetSideLocationBarExpanded(bool expanded) {
+  if (side_location_bar_expanded_ == expanded) {
+    return;
+  }
+
+  side_location_bar_expanded_ = expanded;
+  if (side_layout_enabled_) {
+    InvalidateLayout();
+  }
+}
+
+void ToolbarView::UpdateSideLayoutBackground() {
+  auto* const toolbar_background =
+      background() ? background()->AsA<CustomCornersBackground>() : nullptr;
+  if (!toolbar_background) {
+    return;
+  }
+
+  // Blend in with the vertical tab strip below.
+  toolbar_background->SetPrimaryColor(
+      side_layout_enabled_ ? CustomCornersBackground::FrameTheme()
+                           : CustomCornersBackground::ToolbarTheme());
+}
+
+std::optional<views::ProposedLayout> ToolbarView::CalculateSideLayout(
+    const views::SizeBounds& size_bounds,
+    const base::RepeatingCallback<bool(const views::View*)>& is_included)
+    const {
+  if (!side_layout_enabled_ || !location_bar_view_) {
+    return std::nullopt;
+  }
+
+  const int padding =
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+  const int spacing =
+      GetLayoutConstant(LayoutConstant::kToolbarIconDefaultMargin);
+  const int bottom_padding =
+      GetLayoutConstant(LayoutConstant::kHeliumBasePadding);
+  const int row_height = GetSingleRowHeight();
+  const int location_bar_height =
+      location_bar_view_->GetPreferredSize().height();
+
+  // Only the always-visible buttons of the extensions and pinned actions
+  // containers are shown, the rest overflows.
+  const auto get_width = [this](const views::View* view) {
+    return view == extensions_container_.get() ||
+                   view == pinned_toolbar_actions_container_.get()
+               ? view->GetMinimumSize().width()
+               : view->GetPreferredSize().width();
+  };
+
+  // Buttons that may be shown in the top row, most important first. Anything
+  // that does not fit, and everything else in the toolbar, is hidden and can be
+  // reached through the overflow button.
+  std::vector<views::View*> candidates;
+  const auto add_candidate = [&](views::View* view) {
+    if (view && is_included.Run(view) && !base::Contains(candidates, view)) {
+      candidates.push_back(view);
+    }
+  };
+  add_candidate(app_menu_button_.get());
+  add_candidate(overflow_button_.get());
+  add_candidate(back_.get());
+  add_candidate(forward_.get());
+  add_candidate(reload_.get());
+  if (toolbar_controller_) {
+    for (views::View* child : children()) {
+      if (toolbar_controller_->IsPoppedOut(child)) {
+        add_candidate(child);
+      }
+    }
+  }
+  add_candidate(extensions_container_.get());
+  add_candidate(pinned_toolbar_actions_container_.get());
+  add_candidate(vertical_tabs_collapse_button_.get());
+
+  // Width needed next to the caption buttons before the top row moves below
+  // them. The overflow button is always counted so that showing it does not
+  // move the row back and forth.
+  int essential_width = 0;
+  const views::View* const essential_views[] = {
+      app_menu_button_.get(), overflow_button_.get(), back_.get(),
+      forward_.get(), reload_.get()};
+  for (const views::View* view : essential_views) {
+    if (view && (view == overflow_button_.get() || is_included.Run(view))) {
+      essential_width += get_width(view) + spacing;
+    }
+  }
+
+  int natural_row_width = 0;
+  for (const views::View* view : candidates) {
+    natural_row_width += get_width(view) + spacing;
+  }
+
+  const bool has_width = size_bounds.width().is_bounded();
+  const bool has_height = size_bounds.height().is_bounded();
+  const int host_width =
+      has_width ? size_bounds.width().value() : natural_row_width + 2 * padding;
+  const bool use_geometry =
+      has_width && has_height && side_layout_slot_.has_value();
+  const gfx::Rect slot =
+      use_geometry ? *side_layout_slot_ : gfx::Rect(0, 0, host_width, 0);
+
+  // Lay out the top row next to the caption buttons if they are above the
+  // vertical tab strip, or below them if the row does not fit.
+  const int row_left = slot.x() + padding;
+  const int row_right = slot.right() - padding;
+  const bool has_exclusion =
+      side_exclusion_height_ > 0 &&
+      (side_leading_exclusion_ > 0 || side_trailing_exclusion_ > 0);
+  const int beside_left =
+      std::max(row_left, slot.x() + side_leading_exclusion_);
+  const int beside_right =
+      std::min(row_right, slot.right() - side_trailing_exclusion_);
+  const bool row_below_exclusion =
+      has_exclusion && beside_right - beside_left < essential_width;
+
+  const int top_row_y =
+      slot.y() + (row_below_exclusion ? side_exclusion_height_ : 0);
+  const int top_row_height = has_exclusion && !row_below_exclusion
+                                 ? std::max(row_height, side_exclusion_height_)
+                                 : row_height;
+  const int top_row_left = row_below_exclusion ? row_left : beside_left;
+  const int top_row_right = row_below_exclusion ? row_right : beside_right;
+
+  base::flat_set<const views::View*> shown;
+  int remaining_width = top_row_right - top_row_left;
+  for (const views::View* view : candidates) {
+    const int width = get_width(view);
+    if (width <= 0) {
+      continue;
+    }
+    const int needed_width = width + (shown.empty() ? 0 : spacing);
+    if (needed_width > remaining_width) {
+      continue;
+    }
+    remaining_width -= needed_width;
+    shown.insert(view);
+  }
+
+  // Buttons before the address bar are placed at the leading edge and buttons
+  // after it at the trailing edge, keeping their regular order.
+  base::flat_map<const views::View*, gfx::Rect> child_bounds;
+  const auto get_row_bounds = [&](const views::View* view, int x) {
+    const int height =
+        std::min(view->GetPreferredSize().height(), top_row_height);
+    return gfx::Rect(x, top_row_y + (top_row_height - height) / 2,
+                     get_width(view), height);
+  };
+
+  const auto& toolbar_children = children();
+  const size_t location_bar_index = GetIndexOf(location_bar_view_).value();
+  int leading_x = top_row_left;
+  for (size_t i = 0; i < location_bar_index; ++i) {
+    const views::View* const child = toolbar_children[i];
+    if (shown.contains(child)) {
+      const gfx::Rect bounds = get_row_bounds(child, leading_x);
+      child_bounds[child] = bounds;
+      leading_x = bounds.right() + spacing;
+    }
+  }
+  int trailing_x = top_row_right;
+  for (size_t i = toolbar_children.size(); i > location_bar_index + 1; --i) {
+    const views::View* const child = toolbar_children[i - 1];
+    if (shown.contains(child)) {
+      const gfx::Rect bounds =
+          get_row_bounds(child, trailing_x - get_width(child));
+      child_bounds[child] = bounds;
+      trailing_x = bounds.x() - spacing;
+    }
+  }
+
+  const int location_bar_y = top_row_y + top_row_height;
+  child_bounds[location_bar_view_.get()] =
+      use_geometry && side_floating_location_bar_bounds_
+          ? *side_floating_location_bar_bounds_
+          : gfx::Rect(row_left, location_bar_y, row_right - row_left,
+                      location_bar_height);
+
+  views::ProposedLayout layout;
+  layout.host_size = gfx::Size(
+      host_width, has_height ? size_bounds.height().value()
+                             : location_bar_y + location_bar_height +
+                                   bottom_padding - slot.y());
+  for (views::View* child : children()) {
+    if (!is_included.Run(child)) {
+      continue;
+    }
+    views::ChildLayout& child_layout = layout.child_layouts.emplace_back();
+    child_layout.child_view = child;
+    const auto it = child_bounds.find(child);
+    child_layout.visible = it != child_bounds.end();
+    if (child_layout.visible) {
+      child_layout.bounds = it->second;
+      child_layout.available_size = views::SizeBounds(it->second.size());
+    }
+  }
+  return layout;
+}
