+
+bool BrowserView::ShouldUseSideLocationBar() const {
+  if (!toolbar_ || !toolbar_->CanUseSideLayout() || !GetIsNormalType() ||
+      !GetProfile()->GetPrefs()->GetBoolean(prefs::kHeliumSideLocationBar)) {
+    return false;
+  }
+
+  auto* const layout_controller = HeliumLayoutStateController::From(browser_);
+  if (!layout_controller || !layout_controller->IsVerticalLayout()) {
+    return false;
+  }
+
+  // A collapsed tab strip is too narrow for the address bar, so the toolbar
+  // goes back to the top of the window.
+  auto* const vertical_tab_strip_controller =
+      tabs::VerticalTabStripStateController::From(browser_);
+  if (!vertical_tab_strip_controller ||
+      !vertical_tab_strip_controller->ShouldDisplayVerticalTabs() ||
+      vertical_tab_strip_controller->GetCollapseState() !=
+          tabs::VerticalTabStripCollapseState::kExpanded) {
+    return false;
+  }
+
+  // Zen mode and fullscreen manage the top chrome themselves.
+  return !IsZenModeEnabled() && !IsFullscreen();
+}
+
+void BrowserView::UpdateSideLocationBarPlacement() {
+  if (!toolbar_ || !top_container_ || !GetWidget()) {
+    return;
+  }
+
+  const bool use_side_location_bar = ShouldUseSideLocationBar();
+  if (use_side_location_bar == (toolbar_->parent() == this)) {
+    return;
+  }
+
+  if (use_side_location_bar) {
+    // Paint above the web contents, so the address bar can float over them
+    // while editing, but below the vertical tab strip.
+    const std::optional<size_t> index =
+        vertical_tab_strip_region_view_
+            ? GetIndexOf(vertical_tab_strip_region_view_.get())
+            : std::nullopt;
+    AddChildViewAt(toolbar_.get(), index.value_or(children().size()));
+    toolbar_->SetPaintToLayer();
+    toolbar_->layer()->SetFillsBoundsOpaquely(false);
+  } else {
+    toolbar_->DestroyLayer();
+    top_container_->AddChildViewAt(toolbar_.get(), 0);
+  }
+
+  toolbar_->SetSideLayoutEnabled(use_side_location_bar);
+  InvalidateLayout();
+}
